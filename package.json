{
  "name": "dkstack",
  "version": "0.1.0",
  "description": "Central guidelines, skills, rules, and standards for coding AI agents",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/daniel-kindl/dkstack.git"
  },
  "license": "MIT",
  "scripts": {
    "version:check": "echo \"Current version: $(node -p \"require('./package.json').version\")\"",
    "check:skills": "node scripts/check-skills.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:dashes": "node scripts/check-dashes.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run check:skills && npm run check:links && npm run check:dashes && npm test"
  }
}
