{
  "name": "dkstack",
  "version": "1.6.0",
  "description": "Rules and skills for AI coding agents, in one place.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/daniel-kindl/dkstack.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit:issues": "node scripts/audit-issues.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check:title": "node scripts/check-title.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:maps": "node scripts/check-maps.mjs",
    "check:diagrams": "node scripts/check-diagrams.mjs",
    "check:context": "node scripts/check-context.mjs",
    "check:adrs": "node scripts/check-adrs.mjs",
    "check:suppressions": "node scripts/check-suppressions.mjs",
    "check:todos": "node scripts/check-todos.mjs",
    "check:writing": "node scripts/check-writing.mjs",
    "audit:settings": "node scripts/audit-settings.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-include=scripts/** --test-coverage-lines=95 --test-coverage-branches=90 test/*.test.mjs",
    "check": "npm run check:skills && npm run check:links && npm run check:dashes && npm run check:workflows && npm run check:changelog && npm run check:maps && npm run check:diagrams && npm run check:context && npm run check:adrs && npm run check:suppressions && npm run check:todos && npm run check:writing && npm test"
  }
}
